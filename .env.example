# Local default; on Vercel use your exact HTTPS origin, with no trailing slash.
APP_URL=http://localhost:4317
PORT=4317
OWNER_EMAIL=your-email@example.com
# Generate a long random secret; do not reuse your login password.
BETTER_AUTH_SECRET=
# Required on Vercel: a pooled PostgreSQL connection string (e.g. Neon).
# Local development uses private SQLite when this is empty.
DATABASE_URL=
# Required on Vercel: base64 encoding of 32 random bytes.
# Local development preserves the existing .data/key if this is empty.
DATA_ENCRYPTION_KEY=
# Used ONLY to create the owner if no user exists. Remove after first setup.
INITIAL_PASSWORD=
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
# Register the same URI in your Plaid dashboard when required.
PLAID_REDIRECT_URI=
